# ─────────────────────────────────────────────────────
# CEDH NOC Dashboard — Configuración
# ─────────────────────────────────────────────────────
# Copiar a .env y llenar valores reales.
# NUNCA commitear el .env real.

# ─── Seguridad ───
# Generar con: openssl rand -base64 48
NOC_API_BEARER_TOKEN=changeme-generate-random-token

# ─── Network ───
# IP Tailscale del VPS-MyRock (ver `tailscale ip -4`)
TAILSCALE_IP=100.x.x.x

# Puerto del API (interno, expuesto solo a IP Tailscale)
API_PORT=8000

# Origins permitidos para CORS (Tailscale IPs)
CORS_ALLOWED_ORIGINS=http://100.x.x.x,http://localhost

# ─── SSH ───
SSH_KEY_PATH=/root/.ssh/noc_collector_ed25519
SSH_CONTROL_PATH=~/.ssh/cm-%r@%h:%p
SSH_CONTROL_PERSIST=10m

# ─── Storage ───
SQLITE_DB_PATH=/data/noc.db

# ─── Logging ───
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Polling intervals (segundos) ───
POLL_INTERVAL_HTTP=15
POLL_INTERVAL_METRICS=60
POLL_INTERVAL_DOCKER=60
POLL_INTERVAL_SMTP=60
POLL_INTERVAL_BACKUPS=300
POLL_INTERVAL_DEPLOYS=60
POLL_INTERVAL_SSL=21600
POLL_INTERVAL_DNS=3600
POLL_INTERVAL_PTR=21600

# ─── Cache ───
CACHE_TTL_SECONDS=5

# ─── Timeouts ───
HTTP_TIMEOUT_SECONDS=5
SSH_TIMEOUT_SECONDS=10
DNS_TIMEOUT_SECONDS=3

# ─── Servidores monitoreados ───
# Formato: hostname:nombre_display:provider:region
SERVERS_CONFIG=suig-vps:VPS-SUIG:Hetzner:fsn1,vps-oic:VPS-OIC:Hetzner:nbg1,cedh-mail:VPS-Mail:Contabo:eu

# ─── Resolvers DNS ───
DNS_RESOLVERS=1.1.1.1,8.8.8.8

# ─── Tracing (opcional, V2) ───
# OTEL_EXPORTER_OTLP_ENDPOINT=
